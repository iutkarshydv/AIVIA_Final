// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("NEON_DB_URL")
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  role      UserRole @default(CANDIDATE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]

  @@map("users")
}

enum UserRole {
  CANDIDATE
  INTERVIEWER
  ADMIN
}

model Session {
  id              String        @id @default(uuid())
  userId          String
  agentId         String?
  jobDescription  String        @db.Text
  resumeSummary   Json?
  status          SessionStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcripts     Transcript[]
  evaluations     Evaluation[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("sessions")
}

enum SessionStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
  EXPIRED
}

model Transcript {
  id        String   @id @default(uuid())
  sessionId String
  speaker   Speaker
  seq       Int
  text      String   @db.Text
  metadata  Json?    // {timestamp, partial, duration, etc.}
  createdAt DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, seq])
  @@map("transcripts")
}

enum Speaker {
  CANDIDATE
  AGENT
  SYSTEM
}

model Evaluation {
  id         String   @id @default(uuid())
  sessionId  String
  questionId String?
  scoreJson  Json     // {technical, communication, problemSolving, examples, cultureFit, overall}
  rationale  String   @db.Text
  createdAt  DateTime @default(now())

  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("evaluations")
}

model UsageTracking {
  id            String   @id @default(uuid())
  sessionId     String?
  userId        String
  service       Service
  unitsConsumed Int      // characters for TTS, tokens for Gemini, seconds for STT
  costUsd       Float
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId])
  @@map("usage_tracking")
}

enum Service {
  ELEVENLABS_TTS
  ELEVENLABS_STT
  GEMINI
}
